{
  "version": 2,
  "buildCommand": "npm install",
  "installCommand": "npm install",
  "framework": "node",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "**/node_modules/{@napi-rs,tesseract.js-core,pdfjs-dist}/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
