# Control Energía - Server Environment Variables
# Copy this to .env and fill in your values

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI (optional - for LLM fallback)
OPENAI_API_KEY=sk-your-openai-key

# Server
PORT=3000
NODE_ENV=development
# OpenRouter (opcional pero recomendado): extracción de campos con modelos gratuitos.
# Sin esta clave se usa el extractor por reglas.
OPENROUTER_API_KEY=
# Lista opcional de modelos :free separados por comas (se prueban en cascada)
# OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free,recursive/flint-v1.0:free
