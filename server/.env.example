# Control Energía - Server Environment Variables
# Copy this to .env and fill in your values

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI (optional - for LLM fallback)
OPENAI_API_KEY=sk-your-openai-key

# Server
PORT=3000
NODE_ENV=development
# OpenRouter (opcional pero recomendado): extracción de campos con modelos gratuitos.
# Sin esta clave se usa el extractor por reglas.
OPENROUTER_API_KEY=
# Lista opcional de modelos :free separados por comas (se prueban en cascada)
# OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free,recursive/flint-v1.0:free

# --- Avisos de ahorro por correo (opcional) ---
# Sin proveedor configurado la app funciona igual, pero el aviso solo se guarda
# en la base de datos y no se entrega. Elige UNA de las dos opciones.
#
# Opción A: Resend (HTTP, la más simple en Vercel) → https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CORREO_REMITENTE=Control Energía <avisos@tudominio.es>
#
# Opción B: SMTP (Gmail con contraseña de aplicación, Brevo, Mailtrap…)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# CORREO_REMITENTE=Control Energía <tucuenta@gmail.com>
#
# Dirección que aparece en el correo para que el cliente responda.
# CORREO_CONTACTO=equipo@tudominio.es
#
# Forzar transporte: resend | smtp | registro
# CORREO_TRANSPORTE=
